{
  "name": "liquido",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate-auth.ts && tsx scripts/migrate-simulations.ts && tsx scripts/migrate-products.ts && tsx scripts/migrate-catalog-import.ts && tsx scripts/migrate-batch-reprice.ts && tsx scripts/migrate-billing.ts && tsx scripts/migrate-pix-billing.ts && tsx scripts/migrate-subscription.ts && tsx scripts/migrate-subscription-payments.ts && tsx scripts/migrate-account-data-requests.ts && tsx scripts/migrate-operations.ts",
    "ops:report": "tsx scripts/operations-report.ts",
    "billing:reconcile": "tsx scripts/reconcile-billing.ts",
    "test:auth:integration": "tsx scripts/migrate-auth.ts --test && vitest run src/lib/server/auth.integration.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "mailbox": "node scripts/local-mailbox.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.5",
    "jspdf": "^4.2.1",
    "next": "15.5.26",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^18.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "jsdom": "^30.1.1",
    "smtp-server": "^3.19.13",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
